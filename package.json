{
  "name": "rhino-race",
  "version": "0.1.0",
  "private": true,
  "description": "Rhino Race: a chat-driven Rhino tank race over a real RA2/YR battlefield, for OBS.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/release.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "git config core.hooksPath .githooks",
    "lint": "oxlint --deny-warnings",
    "dev:extension": "vite extension",
    "build:extension": "vite build extension --base ./ --emptyOutDir"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxlint": "^1.92.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  }
}
